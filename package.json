{
    "name": "top-commiters",
    "version": "0.0.1",
    "description": "A website that shows the top 100 github users per country.",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "pnpm run build && wrangler dev",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "gen": "pnpm run gen:cf-types",
        "gen:cf-types": "wrangler types src/worker-configuration.d.ts"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@octokit/auth-app": "^8.3.1",
        "@octokit/core": "^7.0.8",
        "@octokit/plugin-paginate-graphql": "^6.0.0",
        "@octokit/plugin-retry": "^8.1.1",
        "@octokit/plugin-throttling": "^11.0.5",
        "@poppanator/sveltekit-svg": "^7.0.0",
        "@primer/css": "<22.0.0",
        "@primer/octicons": "^19.38.0",
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/kit": "^2.59.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@types/node": "^26.6.2",
        "@types/primer__octicons": "^19.21.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.9.0",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.55.5",
        "svelte-check": "^4.4.7",
        "svelte-meta-tags": "^5.0.2",
        "svelte-sitemap": "^4.0.4",
        "svgo": "^4.1.0",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.10",
        "wrangler": "^4.94.0"
    },
    "packageManager": "pnpm@11.2.2"
}
